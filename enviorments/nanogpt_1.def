Bootstrap: docker
# NGC PyTorch 容器，multi-arch (amd64 + arm64)，原生支持 Hopper (GH200)
# CUDA 12.x + cuDNN + NCCL 全部预装
# 如需更新版本可换成 25.xx 系列，例如 nvcr.io/nvidia/pytorch:25.06-py3
From: nvcr.io/nvidia/pytorch:24.12-py3

%post
    # nanoGPT 全部依赖（含 openwebtext prepare 需要的 tiktoken/datasets）
    pip install --no-cache-dir \
        tiktoken \
        datasets \
        transformers \
        wandb \
        tqdm \
        requests

    # 自检：确认 NGC 自带的 NVIDIA 调优版 torch 没被 PyPI 版本覆盖，
    # 并确认关键依赖都能 import
    python - << 'PYEOF'
import platform, torch, tiktoken, datasets, transformers
print('arch        :', platform.machine())
print('torch       :', torch.__version__)
print('cuda        :', torch.version.cuda)
print('tiktoken    :', tiktoken.__version__)
print('datasets    :', datasets.__version__)
print('transformers:', transformers.__version__)
PYEOF

    # 清理缓存减小镜像体积
    pip cache purge

%environment
    export PYTHONUNBUFFERED=1
    # HF_HOME / WANDB_DIR / NCCL 变量统一放 sbatch 脚本里按需 export，
    # 不写死在镜像里。

%runscript
    exec python "$@"

%labels
    Author licheng
    Description nanoGPT training environment for GH200 (Arrhenius, aarch64)
